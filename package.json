{
  "name": "civ-card-game",
  "version": "1.0.0",
  "private": true,
  "description": "CivCardGame - 文明卡牌游戏",
  "scripts": {
    "dev:web": "pnpm --filter @civ/web dev",
    "build:web": "pnpm --filter @civ/web build",
    "dev:wechat": "pnpm --filter @civ/wechat dev",
    "build:wechat": "pnpm --filter @civ/wechat build",
    "typecheck:douyin": "pnpm --filter @civ/douyin typecheck",
    "build:all": "pnpm -r --if-present build",
    "clean": "node tools/clean.js",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
